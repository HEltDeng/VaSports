.slot{background:#fff;border:3rpx solid transparent;border-radius:18rpx;text-align:center;padding:21rpx 6rpx}.slot-text{display:block}.slot-time{font-size:26rpx;font-weight:600}.slot-state{font-size:22rpx;margin-top:8rpx;color:#318dde}.RESERVED{background:#edf0f5;color:#9ba5b2}.RESERVED .slot-state{color:#8795a6}.UNAVAILABLE,.PAST{background:#f0f1f3;color:#a6adb7}.UNAVAILABLE .slot-state,.PAST .slot-state{color:#9da5b0}.selected{border-color:#2189e9;background:#edf7ff;color:#2189e9}
