.venue-card{position:relative;overflow:hidden;background:#fff;border-radius:28rpx;margin-bottom:30rpx;box-shadow:0 14rpx 32rpx #3984c408;color:#102342}.sport-art{display:block;width:100%;height:182rpx}.art-number{position:absolute;top:32rpx;left:34rpx;color:#1677ff;font-size:100rpx;font-weight:700;line-height:1.25}.art-unit{font-size:32rpx;font-weight:500;margin-left:12rpx}.red .art-number{color:#ef2536}.venue-info{position:relative;padding:28rpx 30rpx 26rpx}.venue-name{font-size:38rpx;font-weight:700;line-height:1.25;position:relative;z-index:1}.venue-cta{position:absolute;right:24rpx;top:23rpx;background:#5ca2ff;color:#fff;border-radius:48rpx;padding:14rpx 28rpx;font-size:26rpx;font-weight:600;line-height:1.4;display:flex;align-items:center;gap:16rpx}.cta-arrow{font-size:34rpx;line-height:1}.red .venue-cta{background:#ff6c73}.hours,.location,.free{font-size:22rpx;color:#7283a0;display:flex;align-items:center}.meta-icon{width:27rpx;height:27rpx;margin-right:7rpx;flex-shrink:0}.hours{margin-top:27rpx}.location{position:absolute;left:245rpx;bottom:28rpx;font-size:21rpx}.free{position:relative;margin-top:20rpx}.venue-bottom .free{display:none}.compact{min-height:310rpx;background:#fafdff}.compact .sport-art{position:absolute;right:0;top:0;width:100%;height:220rpx}.compact .venue-info{padding:32rpx 30rpx 22rpx}.compact .venue-name{font-size:36rpx}.compact .venue-sub{font-size:25rpx;color:#536987;margin-top:18rpx;position:relative}.compact .location{position:relative;left:auto;bottom:auto;display:inline-flex;padding:5rpx 12rpx;border-radius:32rpx;border:1rpx solid #e9eff6;background:#ffffff65;font-size:22rpx;margin-top:14rpx}.compact .venue-bottom{position:relative;display:flex;align-items:center;justify-content:space-between;margin-top:25rpx;min-height:68rpx}.compact .venue-bottom .free{display:flex;margin:0;font-size:24rpx;gap:8rpx}.free-number{font-size:56rpx;line-height:1;color:#076bff;font-weight:650}.red .free-number{color:#e82732}.compact .venue-cta{position:static;background:#e5f1ff;color:#0067f5;min-width:200rpx;justify-content:center;padding:14rpx 24rpx}.compact.red .venue-cta{background:#ffe6e8;color:#e6202c}.compact.red{background:#fffafb}
.list-free{margin-left:auto;font-size:21rpx}.venue-card:not(.compact) .location{position:static;margin-top:16rpx}.venue-card:not(.compact) .hours{margin-top:10rpx}

.venue-card:not(.compact) .hours,.venue-card:not(.compact) .location{font-size:25rpx}.venue-card:not(.compact) .list-free{font-size:23rpx}
