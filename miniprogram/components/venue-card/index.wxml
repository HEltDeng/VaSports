<view class="venue-card {{venue.tone}} {{compact?'compact':''}}" bindtap="open" role="button" aria-label="{{venue.name}}，查看可预约时段">
<image class="sport-art" src="/assets/{{venue.id}}-panel.png" mode="aspectFill"/>
<view wx:if="{{!compact}}" class="art-number">{{venue.count}}<text class="art-unit">{{venue.unit}}</text></view>
<view class="venue-info"><view class="venue-name">{{venue.name}}</view><view wx:if="{{compact}}" class="venue-sub">{{venue.count}} 个{{venue.unit === '台' ? '球台' : '场地'}} · {{venue.hours}}</view><view class="location"><image class="meta-icon" src="/assets/icons/map-pin.png"/>{{venue.location}}</view><view class="venue-bottom"><view class="free"><text wx:if="{{compact}}" class="free-number">{{venue.free}}</text><text wx:else>{{venue.free}}</text> 个空闲场次</view><view class="venue-cta">可预约 <text class="cta-arrow">›</text></view></view><view wx:if="{{!compact}}" class="hours"><image class="meta-icon" src="/assets/icons/clock.png"/>{{venue.hours}}<text class="list-free">{{venue.free}} 个空闲场次</text></view></view></view>
