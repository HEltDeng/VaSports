.court-card{background:#fff;border:3rpx solid transparent;border-radius:22rpx;padding:24rpx;text-align:center}.selected{border-color:#2189e9;background:#f0f8ff}.disabled{background:#ecf0f5;color:#8f9baa}.court-mini{width:80rpx;height:42rpx;border:2rpx solid #8fbce3;margin:0 auto 16rpx;position:relative}.court-net{position:absolute;left:50%;height:100%;border-left:2rpx solid #8fbce3}.court-name{font-weight:600;font-size:29rpx}.court-status{color:#2488de;font-size:23rpx;margin-top:5rpx}.disabled .court-status{color:#8a98a9}.court-free{font-size:21rpx;color:#93a1af}
