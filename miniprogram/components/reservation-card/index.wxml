<view class="card"><view class="row"><text class="section-title">{{reservation.venueName}}</text><text class="pill {{reservation.displayState}}">{{reservation.statusText}}</text></view><view class="reservation-court">{{reservation.courtNumber}}号{{reservation.unit}}</view><view class="reservation-time">{{reservation.date}} · {{reservation.timeSlot}}</view><view wx:if="{{reservation.canCancel || reservation.canShowCode}}" class="reservation-bottom"><button wx:if="{{reservation.canCancel}}" class="cancel" bindtap="cancel">取消预约</button><button wx:if="{{reservation.canShowCode}}" class="code-button" bindtap="code">核销码</button></view></view>
