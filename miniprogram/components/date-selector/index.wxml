<scroll-view scroll-x class="date-scroll" enhanced show-scrollbar="{{false}}"><view class="date-track"><view wx:for="{{days}}" wx:key="value" class="date-item {{value===item.value?'chosen':''}}" data-value="{{item.value}}" bindtap="choose" role="button" aria-label="{{item.label}} {{item.short}}"><text class="date-text">{{item.label}}</text><text class="date-text date-number">{{item.short}}</text></view></view></scroll-view>
