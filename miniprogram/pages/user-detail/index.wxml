<view class="account-page"><view class="title">个人资料</view><view wx:if="{{message}}" class="error">{{message}}</view><view wx:if="{{user}}" class="form-card"><view class="detail-row"><text>姓名 / 称呼</text><text>{{user.displayName}}</text></view><view class="detail-row"><text>当前身份</text><text>{{user.identityText}}</text></view><view class="detail-row"><text>手机号</text><text>{{user.phone.masked || '未绑定'}}</text></view><view wx:if="{{user.student && user.identity==='STUDENT'}}" class="detail-row"><text>学号</text><text>{{user.student.studentCode}}</text></view></view><button class="primary" bindtap="edit">完善或修改资料</button><button class="secondary" bindtap="phone">更换手机号</button><view class="text-link" bindtap="home">返回我的</view></view>
