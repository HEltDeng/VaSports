<view class="account-page"><view class="title">完善访客资料</view><view wx:if="{{message}}" class="error">{{message}}</view><view class="form-card"><view class="field"><view class="label">姓氏</view><input class="input" placeholder="请输入姓氏" maxlength="30" value="{{surname}}" bindinput="input"/></view><view class="field"><view class="label">称呼</view><view class="choices"><view class="choice {{honorific==='MR'?'active':''}}" data-value="MR" bindtap="choose">先生</view><view class="choice {{honorific==='MS'?'active':''}}" data-value="MS" bindtap="choose">女士</view><view class="choice {{honorific==='NONE'?'active':''}}" data-value="NONE" bindtap="choose">不设置</view></view></view><view class="row"><view><view class="label">联系手机号</view><view class="muted">{{user.phone.masked}}</view></view><text class="link" bindtap="phone">更换</text></view></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">完成并进入</button><view class="text-link" bindtap="back">重新选择身份</view></view>
