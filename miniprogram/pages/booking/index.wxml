<view class="page"><view class="steps">01 日期与场位　→　<text class="active">02 时段</text>　→　03 确认</view><view class="title">选择时段</view><view wx:if="{{venue}}" class="subtitle">{{venue.name}} · {{selection.courtNumber}}号{{venue.unit}}</view><view class="card section"><view class="row"><text>预约日期</text><text class="badge">{{selection.date}}</text></view></view><view class="section-head"><text class="section-title">选择时段</text><text class="muted">每次预约 1 小时</text></view><view class="legend"><text>● 空闲</text><text>● 已预约</text><text>● 不可用 / 已开场</text></view><view wx:if="{{loading}}" class="notice">正在读取时段…</view><view wx:elif="{{loadError}}" class="error" bindtap="refresh">{{loadError}} · 点击重试</view><view wx:else class="grid"><time-slot wx:for="{{slots}}" wx:key="timeSlot" time-info="{{item}}" selected="{{chosen===item.timeSlot}}" bind:select="choose"/></view><button class="primary" disabled="{{!chosen || loading || !!loadError}}" bindtap="next">{{chosen?'下一步，确认预约':'请选择一个空闲时段'}}</button></view>
