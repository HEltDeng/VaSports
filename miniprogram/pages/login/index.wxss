@import '../../styles/account.wxss';@import '../../styles/visual.wxss';
.login-page{background:#f7fcfa}.login-page{min-height:calc(100vh - 88px);padding:0 48rpx 36rpx;text-align:center}.login-page::after{background:linear-gradient(160deg,#d5f4e780,#f7fcfa20)}.login-brand{margin:0;padding-top:100rpx}.brand-logo{width:174rpx;height:174rpx;border-radius:36rpx;box-shadow:0 14rpx 32rpx #154d3b12}.brand{font-size:66rpx;font-weight:750;color:#182b42;line-height:1.25;margin-top:22rpx;letter-spacing:-2rpx}.product-name{font-size:33rpx;color:#526278;margin-top:16rpx;letter-spacing:3rpx}.tagline{font-size:24rpx;color:#96a4b3;letter-spacing:6rpx;margin-top:38rpx}.login-actions{margin-top:92rpx}.login-page .login-button{background:linear-gradient(110deg,#19b17a,#5cda65);height:116rpx;line-height:116rpx;font-size:36rpx;margin:0;box-shadow:0 12rpx 30rpx #23bb7720}.login-page .browse-button{background:#fff;color:#08a954;height:100rpx;line-height:100rpx;font-size:30rpx;font-weight:600;margin-top:26rpx;border:1rpx solid #deeee7;box-shadow:0 8rpx 22rpx #189b5810}.agreement{justify-content:center;gap:6rpx;margin:60rpx -22rpx 0;font-size:21rpx;flex-wrap:wrap}.agreement .link{color:#06a856;font-size:21rpx}.agreement-check{transform:scale(.74);margin-right:-5rpx}.switch-account{color:#1cad6b;font-size:26rpx;padding:32rpx;margin-top:38rpx}.error{text-align:left;font-size:24rpx}

.login-backdrop{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}.login-page::after{display:none}
