<view class="visual-page home-page"><button class="primary quick-button" bindtap="quick"><image src="/assets/icons/calendar-check-white.png"/><text>快速预约</text><text class="arrow">›</text></button><view wx:if="{{loadError}}" class="error" bindtap="load">{{loadError}} · 点击重试</view>
<view class="overview"><view><text class="stat blue">2</text><text class="stat-label">运动场馆</text></view><view><text class="stat">18</text><text class="stat-label">场地 / 球台</text></view><view><text class="stat blue">{{total}}</text><text class="stat-label">今日空闲场次</text></view></view>
<view class="section"><view class="section-head"><text class="section-title">场馆预约</text><text class="link" bindtap="quick">全部场馆 ›</text></view><venue-card wx:for="{{venues}}" wx:key="id" venue="{{item}}" compact="{{true}}" bind:select="openVenue"/></view>
<view wx:if="{{recent}}" class="section recent"><view class="section-head"><text class="section-title">我的最近预约</text><text class="link" bindtap="my">查看全部 ›</text></view><view class="card" bindtap="my"><view class="row"><text>{{recent.venueName}} · {{recent.courtNumber}}号{{recent.unit}}</text><text class="badge">{{recent.statusText}}</text></view><view class="muted">{{recent.date}} {{recent.timeSlot}}</view></view></view></view>
