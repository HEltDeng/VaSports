<view class="page"><view class="title">我的运动日程</view><view class="filters"><view wx:for="{{filters}}" wx:key="id" data-id="{{item.id}}" bindtap="filter" class="filter {{filter===item.id?'active':''}}">{{item.label}}</view></view><view wx:if="{{loadError}}" class="error" bindtap="load">{{loadError}} · 点击重试</view><reservation-card wx:for="{{records}}" wx:key="id" reservation="{{item}}" bind:cancel="cancel" bind:code="code"/><empty-state wx:if="{{!records.length && !loadError}}" title="{{filter==='ACTIVE'?'还没有待使用的预约':filter==='COMPLETED'?'暂无已核销或已结束的预约':'还没有取消过预约'}}" description="{{filter==='ACTIVE'?'选择场馆后可创建预约。':filter==='COMPLETED'?'已核销与已结束的记录在此查看。':'已取消的记录在此查看。'}}"/><button wx:if="{{filter==='ACTIVE' && !records.length}}" class="primary" bindtap="book">去预约场馆</button></view>
