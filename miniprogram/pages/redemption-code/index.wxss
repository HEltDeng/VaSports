@import '../../styles/visual.wxss';
.code-card{background:#fff;border-radius:28rpx;padding:34rpx 28rpx;text-align:center}.code-title{font-size:36rpx;font-weight:650}.code-date{font-size:28rpx;margin-top:16rpx;color:#6d8299}.code-time{font-size:34rpx;font-weight:600;margin-top:4rpx}.qr-image{display:block;width:100%;max-width:510rpx;margin:26rpx auto 12rpx;background:#fff}.code-status{font-size:30rpx;font-weight:600;color:#2388e4}.code-expiry{color:#8797a8;font-size:23rpx;margin-top:8rpx}.code-feedback{padding:70rpx 10rpx;color:#6d8198;font-size:30rpx;min-height:300rpx}.code-page{padding-top:26rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}

.code-card{border-radius:32rpx;box-shadow:0 14rpx 40rpx #3984c40a}.code-title{color:#102342}.code-status{color:#1677ff}
