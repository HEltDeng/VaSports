@import '../../styles/visual.wxss';.identity-page{padding-top:70rpx;min-height:calc(100vh - 88px)}.identity-page .title{font-size:58rpx;margin:0 0 12rpx}.identity-page .subtitle{font-size:29rpx;color:#7889a4;margin-bottom:60rpx}.identity-panel{min-height:244rpx;border-radius:30rpx;padding:28rpx 24rpx;display:flex;align-items:center;gap:24rpx;margin-bottom:32rpx;border:2rpx solid #fff;box-shadow:0 10rpx 32rpx #6d9ccc12}.visitor{background:linear-gradient(110deg,#f3fcfa,#e0f6f0)}.campus{background:linear-gradient(110deg,#f2f7ff,#dfecff)}.identity-icon{height:104rpx;width:104rpx;border-radius:50%;background:#43b79f;display:flex;align-items:center;justify-content:center;flex-shrink:0}.campus .identity-icon{background:#3988ff}.identity-icon image{width:62rpx;height:62rpx}.identity-copy{flex:1;min-width:0}.identity-title{font-size:33rpx;font-weight:700;white-space:nowrap}.campus-title{font-size:30rpx}.identity-help{font-size:21rpx;color:#7486a2;margin-top:14rpx}.enter{background:#43b79f;color:#fff;border-radius:60rpx;padding:17rpx 21rpx;font-size:24rpx;font-weight:600;white-space:nowrap;flex-shrink:0}.enter text{margin-left:8rpx}.campus .enter{background:#3988ff}@media(max-width:360px){.identity-panel{gap:16rpx;padding:24rpx 18rpx}.identity-icon{width:84rpx;height:84rpx}.identity-title{font-size:30rpx}.campus-title{font-size:27rpx}.enter{font-size:22rpx;padding:15rpx}.identity-help{font-size:20rpx}}
