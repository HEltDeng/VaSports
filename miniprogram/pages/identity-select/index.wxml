<view class="visual-page identity-page"><view class="title">选择身份</view><view class="subtitle">不同身份，享受专属的场馆服务</view><view wx:if="{{message}}" class="error">{{message}}</view>
<view class="identity-panel visitor" data-identity="VISITOR" bindtap="select" role="button"><view class="identity-icon"><image src="/assets/icons/user-round-white.png"/></view><view class="identity-copy"><view class="identity-title">校外访客</view><view class="identity-help">预约参观或使用体育场馆</view></view><view class="enter">立即进入 <text>→</text></view></view>
<view class="identity-panel campus" data-identity="STUDENT" bindtap="select" role="button"><view class="identity-icon"><image src="/assets/icons/graduation-cap-white.png"/></view><view class="identity-copy"><view class="identity-title campus-title">本校学生 / 教职工</view><view class="identity-help">完善资料，申请校园身份</view></view><view class="enter">立即进入 <text>→</text></view></view></view>
