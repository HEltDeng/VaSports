<view class="page"><view class="steps"><text class="active">01 日期与场位</text>　→　02 时段　→　03 确认</view><block wx:if="{{venue}}"><view class="title">{{venue.name}}</view><view class="subtitle">{{venue.location}} · {{venue.hours}}</view><view class="chips section"><text wx:for="{{venue.facilities}}" wx:key="*this" class="chip">{{item}}</text></view><view class="section-title section">选择日期</view><date-selector days="{{days}}" value="{{date}}" bind:change="changeDate"/><view class="section-head"><text class="section-title">选择{{venue.unit==='台'?'球台':'场地'}}</text><text class="muted">先选场位，再看时段</text></view><view wx:if="{{loading}}" class="notice">正在读取场地状态…</view><view wx:elif="{{loadError}}" class="error" bindtap="refresh">{{loadError}} · 点击重试</view><view wx:else class="grid"><court-card wx:for="{{courts}}" wx:key="number" court="{{item}}" unit="{{venue.unit}}" selected="{{selected===item.number}}" bind:select="choose"/></view><button class="primary" disabled="{{!selected || loading || !!loadError}}" bindtap="next">{{selected?'选择 '+selected+'号'+venue.unit+' 的时段':'请先选择场位'}}</button></block><view wx:elif="{{loadError}}" class="error">{{loadError}}</view></view>
