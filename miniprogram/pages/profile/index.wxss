@import '../../styles/visual.wxss';.profile-page{padding-top:58rpx}.profile-header{display:flex;align-items:center;gap:28rpx;padding:14rpx 20rpx 40rpx}.avatar{width:112rpx;height:112rpx;border-radius:26rpx;background:#1677ff;color:#fff;font-size:58rpx;font-weight:650;display:flex;align-items:center;justify-content:center;flex-shrink:0}.profile-name{font-size:36rpx;font-weight:700}.identity-label{color:#7287a3;font-size:27rpx;margin-top:8rpx}.stats{display:flex;border-radius:28rpx;background:#fff;padding:30rpx 0;margin-bottom:24rpx}.stat-item{flex:1;text-align:center;font-size:25rpx;color:#6c819e}.stat-item+.stat-item{border-left:1rpx solid #e5edf8}.number{display:block;color:#102342;font-size:52rpx;font-weight:650;line-height:1.3;margin-bottom:12rpx}.menu{background:#fff;border-radius:28rpx;padding:6rpx 32rpx;margin-bottom:30rpx}.menu-row{display:flex;align-items:center;gap:32rpx;min-height:94rpx;position:relative;font-size:28rpx}.menu-row+ .menu-row::before{content:'';position:absolute;top:0;left:78rpx;right:0;height:1rpx;background:#e9eef6}.menu-icon{width:42rpx;height:42rpx;flex-shrink:0}.menu-row .chevron{margin-left:auto;color:#7d8fa8;font-size:38rpx}.profile-page .logout{height:92rpx;line-height:92rpx;background:#dfedff;font-size:29rpx;font-weight:600;color:#1677ff;margin:0}

.menu-row{width:100%!important;margin:0;padding:0;background:transparent;text-align:left;border-radius:0;color:#102342;line-height:1.55;font-weight:400}.menu-row::after{border:0}
