<view class="visual-page profile-page"><view class="profile-header" bindtap="details"><view class="avatar">{{user.avatar || 'V'}}</view><view><view class="profile-name">{{user.displayName || '点击登录'}}</view><view class="identity-label">{{user.identityText}}</view></view></view><view wx:if="{{message}}" class="error">{{message}}</view><view class="stats" bindtap="my"><view class="stat-item"><text class="number">{{active}}</text><text>待使用 / 使用中</text></view><view class="stat-item"><text class="number">{{completed}}</text><text>已核销 / 已结束</text></view></view><view class="menu">
<button class="menu-row" bindtap="my"><image class="menu-icon" src="/assets/icons/calendar-check.png"/><text>我的预约</text><text class="chevron">›</text></button><button class="menu-row" bindtap="orders"><image class="menu-icon" src="/assets/icons/receipt-text.png"/><text>我的订单</text><text class="chevron">›</text></button><button class="menu-row" bindtap="rules"><image class="menu-icon" src="/assets/icons/file-text.png"/><text>预约与取消规则</text><text class="chevron">›</text></button><button class="menu-row" bindtap="privacy"><image class="menu-icon" src="/assets/icons/shield-check.png"/><text>隐私说明</text><text class="chevron">›</text></button><button class="menu-row" bindtap="details"><image class="menu-icon" src="/assets/icons/user-round.png"/><text>个人资料</text><text class="chevron">›</text></button><button class="menu-row" bindtap="about"><image class="menu-icon" src="/assets/icons/info.png"/><text>关于 VaSports</text><text class="chevron">›</text></button></view><button wx:if="{{user}}" class="secondary logout" bindtap="logout">退出登录</button></view>
