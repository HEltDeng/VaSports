<view class="visual-page phone-page"><image class="phone-art" src="/assets/phone-verification.png" mode="aspectFit"/><view class="title">绑定手机号</view><view class="help">用于预约联系和账号验证。</view><view class="phone-actions"><view wx:if="{{message}}" class="error">{{message}}</view><view wx:if="{{user.phone && !changing}}"><view class="label">已绑定手机号</view><view class="phone-value">{{user.phone.masked}}</view><button class="primary" bindtap="next">继续</button></view><block wx:else><button wx:if="{{demo}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="bind">绑定手机号</button><button wx:elif="{{native}}" class="primary" open-type="getPhoneNumber" bindgetphonenumber="bind" loading="{{busy}}" disabled="{{busy}}">绑定手机号</button><view wx:else class="form-card"><input class="input" type="number" maxlength="11" placeholder="请输入手机号" data-field="phone" bindinput="input"/><button class="secondary" bindtap="sendSms">获取验证码</button><input class="input" type="number" placeholder="短信验证码" data-field="smsCode" bindinput="input"/><button class="primary" bindtap="verify" disabled="{{busy}}">验证并绑定</button></view></block><button class="secondary" bindtap="cancel">暂不绑定，先看看场馆</button></view></view>
