<view class="account-page"><view class="title">学生身份核验</view><view wx:if="{{message}}" class="error">{{message}}</view><view wx:if="{{editing}}" class="form-card"><view class="field"><view class="label">姓名</view><input class="input" placeholder="请输入姓名" maxlength="60" value="{{realName}}" data-field="realName" bindinput="input"/></view><view class="field"><view class="label">学号</view><input class="input" placeholder="请输入学号" type="text" maxlength="32" value="{{studentCode}}" data-field="studentCode" bindinput="input"/></view><view class="help">用于核验本校学生身份及适用预约规则。</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交核验</button></view><view wx:else class="form-card"><view class="status-title">{{statusLabel}}</view><view class="muted-row">{{user.student.realName}} · {{user.student.studentCode}}</view><view class="status-help" wx:if="{{status==='PENDING'}}">资料已提交，待审核后确认学生资格。</view><view class="status-help" wx:if="{{status==='REJECTED'}}">请核对姓名与学号后重试。</view><view class="status-help" wx:if="{{status==='EXPIRED'}}">学生资格已失效，请重新提交核验。</view><button wx:if="{{status==='APPROVED'}}" class="primary" bindtap="next">完成并进入</button><button wx:elif="{{status==='PENDING'}}" class="secondary" bindtap="refresh">刷新核验状态</button><button class="secondary" bindtap="edit">修改资料</button></view><view class="text-link" bindtap="choose">重新选择身份</view><view wx:if="{{status!=='APPROVED'}}" class="text-link" bindtap="browse">先看看场馆</view></view>
