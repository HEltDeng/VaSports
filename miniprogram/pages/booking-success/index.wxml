<view class="page"><view wx:if="{{loadError}}" class="error">{{loadError}}</view><block wx:if="{{reservation}}"><view class="success-header"><view class="success-mark">✓</view><view class="title">预约成功</view></view><view class="card"><view class="row"><text class="section-title">{{reservation.venueName}}</text><text class="pill">{{reservation.statusText}}</text></view><view class="detail-row"><text>日期</text><text>{{reservation.date}}</text></view><view class="detail-row"><text>时段</text><text>{{reservation.timeSlot}}</text></view><view class="detail-row"><text>场位</text><text>{{reservation.courtNumber}}号{{reservation.unit}}</text></view><view class="muted small">预约编号 {{reservation.id}}</view></view><button wx:if="{{reservation.canShowCode}}" class="primary" bindtap="code">查看核销码</button><button class="secondary" bindtap="my">查看我的预约</button><button class="secondary" bindtap="more">继续预约</button></block></view>
