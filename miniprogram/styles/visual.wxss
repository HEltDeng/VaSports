.visual-page{background:#f3f9ff;color:#102342}.visual-page{position:relative;min-height:calc(100vh - 100rpx);padding:32rpx 32rpx 70rpx;z-index:0}.visual-page::after{content:'';position:fixed;z-index:-1;bottom:-110rpx;left:-15%;width:130%;height:270rpx;border-radius:50% 50% 0 0;background:linear-gradient(160deg,#dcecff80,#f5faff30);transform:rotate(-7deg);pointer-events:none}.visual-page .primary{background:#3289ff;border-radius:28rpx;box-shadow:0 10rpx 28rpx #2588ff18}.visual-page .secondary{border-radius:28rpx}.visual-page .title{color:#102342}.visual-page .link{color:#1677ff}.ui-icon{width:42rpx;height:42rpx;flex-shrink:0}.arrow{font-size:42rpx;font-weight:400;line-height:1}.visual-page .section-title{font-size:36rpx;font-weight:700}
