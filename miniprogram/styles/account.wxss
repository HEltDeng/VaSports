.account-page{padding:48rpx 34rpx calc(60rpx + env(safe-area-inset-bottom))}.account-page .title{font-size:42rpx;margin:10rpx 0 34rpx}.form-card{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx}.field{margin-bottom:30rpx}.field:last-child{margin-bottom:0}.label{font-weight:600;margin-bottom:14rpx}.input{height:92rpx;line-height:92rpx;border-radius:16rpx;background:#f5f8fc;padding:0 22rpx;font-size:29rpx;width:100%;box-sizing:border-box}.help{font-size:24rpx;color:#74869a;margin:20rpx 0}.text-link{color:#2987dc;text-align:center;padding:24rpx 0;font-size:26rpx}.identity-card{background:#fff;padding:42rpx 30rpx;border-radius:24rpx;margin-top:22rpx;display:flex;justify-content:space-between;font-size:34rpx;font-weight:600}.choices{display:flex;gap:16rpx}.choice{flex:1;text-align:center;padding:20rpx 0;background:#f1f5fa;border-radius:16rpx;color:#6d8094}.choice.active{background:#e6f2ff;color:#2189e9;box-shadow:inset 0 0 0 2rpx #2189e9}.status-title{font-size:34rpx;font-weight:600;margin-bottom:14rpx}.login-brand{margin:90rpx 0 60rpx}.brand{font-size:56rpx;font-weight:750;color:#2189e9}.product-name{font-size:33rpx;margin-top:14rpx}.agreement{font-size:23rpx;color:#75879b;margin:30rpx 0;display:flex;flex-wrap:wrap;align-items:center;gap:8rpx}.agreement .link{font-size:23rpx}.account-page .error{margin-top:20rpx}.phone-value{font-size:38rpx;letter-spacing:3rpx;padding:26rpx 0}.status-approved{color:#2189e9}.muted-row{padding:16rpx 0;color:#697f96;word-break:break-all}.account-page .primary{margin-top:24rpx}.status-help{color:#6d8198;font-size:26rpx;line-height:1.8}.login-footer{margin-top:54rpx}.account-page .primary,.account-page .secondary{font-size:28rpx}
