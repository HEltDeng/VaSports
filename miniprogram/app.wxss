page{background:#f5f8fc;color:#1b3149;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;font-size:28rpx;line-height:1.55}view,text,button{box-sizing:border-box}button{font-size:28rpx}button::after{border:0}.page{padding:32rpx 32rpx 52rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#718ca8;font-weight:600}.title{font-size:44rpx;font-weight:700;letter-spacing:1rpx;line-height:1.3;margin:12rpx 0}.subtitle{font-size:26rpx;color:#8090a3}.section{margin-top:38rpx}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}.section-title{font-size:32rpx;font-weight:650}.link{font-size:24rpx;color:#2189e9}.card{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx}.row{display:flex;align-items:center;justify-content:space-between}.muted{color:#8593a4;font-size:24rpx}.pill{display:inline-block;border-radius:12rpx;background:#ebf5ff;color:#2382d6;padding:6rpx 16rpx;font-size:22rpx}.primary{background:#2189e9;color:#fff;border-radius:22rpx;height:94rpx;line-height:94rpx;font-weight:600;margin-top:26rpx}.primary[disabled]{background:#dbe6f1;color:#8ba1b8}.secondary{background:#edf5fc;color:#2584dc;border-radius:22rpx;margin-top:20rpx;height:88rpx;line-height:88rpx}.notice{background:#edf6ff;color:#6381a0;border-radius:20rpx;padding:22rpx 24rpx;font-size:24rpx;line-height:1.8}.small{font-size:22rpx}.gap{height:24rpx}.detail-row{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #f0f4f8}.detail-row:last-child{border:0}.detail-row text:first-child{color:#8795a6}.detail-row text:last-child{text-align:right;font-weight:500}.badge{color:#2388e4;font-size:24rpx}.rules{font-size:25rpx;color:#728399;line-height:1.95}.steps{font-size:22rpx;color:#7990a8;margin-bottom:24rpx;letter-spacing:2rpx}.steps .active{color:#2189e9;font-weight:600}.error{color:#b55e45;background:#fff1ea;padding:22rpx;border-radius:18rpx;margin-bottom:20rpx}.footer-note{text-align:center;color:#93a1b2;font-size:21rpx;margin-top:34rpx}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{background:#f1f6fb;color:#6b8098;padding:7rpx 17rpx;border-radius:10rpx;font-size:22rpx}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}

.primary,.secondary{width:100%!important;padding:0 24rpx;box-sizing:border-box}
